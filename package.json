{
  "name": "teegold",
  "version": "0.1.0",
  "private": true,
  "description": "Teegold Interiors Management System",
  "license": "UNLICENSED",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "yarn build:shared && concurrently -n server,client -c magenta,cyan \"yarn dev:server\" \"yarn dev:client\"",
    "dev:server": "yarn workspace @teegold/server dev",
    "dev:client": "yarn workspace @teegold/client dev",
    "build": "yarn build:shared && yarn workspace @teegold/server build && yarn workspace @teegold/client build",
    "build:shared": "yarn workspace @teegold/shared build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f server/docker-compose.yml up -d",
    "db:down": "docker compose -f server/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
