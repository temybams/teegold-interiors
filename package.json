{
  "name": "teegold",
  "version": "0.1.0",
  "private": true,
  "description": "Teegold Interiors Management System",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "yarn build:shared && concurrently -n api,web -c magenta,cyan \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "yarn workspace @teegold/api dev",
    "dev:web": "yarn workspace @teegold/web dev",
    "build": "yarn build:shared && yarn workspace @teegold/api build && yarn workspace @teegold/web build",
    "build:shared": "yarn workspace @teegold/shared build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
