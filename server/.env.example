# Copy to server/.env

NODE_ENV=development
PORT=4000

# Origin allowed to call this API (the Next.js client)
CLIENT_ORIGIN=http://localhost:3000

# Postgres from server/docker-compose.yml (`yarn db:up`).
# Host port is 5433 so it never clashes with another Postgres already on 5432.
DATABASE_URL="postgresql://teegold:teegold@localhost:5433/teegold?schema=public"

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional. Without these, invite and reset emails are printed in the server log
# and the admin is told to send the link on WhatsApp instead.
# For production Gmail, use an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Teegold Interiors <hello@teegoldinteriors.ng>"

# The first admin, created by `yarn db:seed`. Change these before seeding.
# On Render, set the same keys then run `yarn db:seed` once in the service Shell.
SEED_ADMIN_NAME="Teegold Admin"
SEED_ADMIN_EMAIL=admin@teegoldinteriors.ng
SEED_ADMIN_PASSWORD=change-this-password
