# Copy to apps/api/.env and adjust as needed.

NODE_ENV=development
PORT=4000

# Origin allowed to call this API (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Postgres from docker-compose.yml at the repo root (`yarn db:up`). Used from Stage 2.
DATABASE_URL="postgresql://teegold:teegold@localhost:5432/teegold?schema=public"
